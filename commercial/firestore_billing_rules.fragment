// Add these payment and institution match blocks to the existing Firestore `match /databases/{database}/documents`.
// DO NOT replace your entire production Firestore rules with this fragment.
// Server Firebase Admin SDK bypasses client rules; only authenticated
// callable functions may expose entitlement status, never raw token records.
match /billingTokensV1/{purchaseTokenHash} {
  allow read, write: if false;
}
match /parentPremiumEntitlementsV1/{parentUid} {
  allow read, write: if false;
}

match /institutionContractsV1/{contractId} {
  allow read, write: if false;
}
match /institutionCodeBatchesV1/{batchId} {
  allow read, write: if false;
}
match /institutionCodesV1/{codeHash} {
  allow read, write: if false;
}
match /institutionAssignmentsV1/{seatKey} {
  allow read, write: if false;
}
match /parentStudentProfilesV1/{guardianUid}/profiles/{studentProfileId} {
  allow read, write: if false;
}
match /institutionRedemptionsV1/{codeHash} {
  allow read, write: if false;
}
